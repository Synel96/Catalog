# Copy to .env (git-ignored) and fill in. Real environment variables win.

# Neon: Dashboard → Connect → pick the *pooled* connection string.
# Leave unset to use the local SQLite file (db.sqlite3).
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456-pooler.eu-central-1.aws.neon.tech/catalog?sslmode=require

# Seconds to keep DB connections open; 0 (default) suits ASGI + Neon's pooler.
# DB_CONN_MAX_AGE=0
