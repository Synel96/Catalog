# Public app settings (available in browser)
VITE_SITE_URL=http://localhost:5173
VITE_BRAND_NAME=Catalog

# Django backend (cookie-based JWT auth), including the /api prefix
VITE_API_URL=http://localhost:8000/api

# "true" replaces the backend with in-browser mocks (MSW), see README
VITE_API_MOCKS=false
